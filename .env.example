# Copy to .env and fill in. .env is gitignored.

# Places API (New) key. Used ONLY by crawler/. Backend never calls Places,
# so the whole test suite must pass with this unset.
GOOGLE_PLACES_API_KEY=

PORT=3000

# Daily request cap for the crawler (see task_plan.txt section 5).
CRAWLER_DAILY_CAP=450

# 1 = print planned requests and exit without spending.
CRAWLER_DRY_RUN=1

# 1 = serve only shops that have a phone number (see plan 3.1).
REQUIRE_PHONE=1
